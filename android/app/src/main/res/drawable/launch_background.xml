<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the dark background with the app icon in
     the middle, where the ShelfSync splash then draws it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/shelfsync_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
